# Publish only the website source, public assets and build configuration.
/*
!/.gitignore
!/.vercelignore
!/package.json
!/package-lock.json
!/next-env.d.ts
!/next.config.ts
!/postcss.config.mjs
!/tsconfig.json
!/src/
!/public/

# Local originals and media preparation inventory are not website assets.
/public/fonts/*.ttf
/public/media/manifest.json
**/.DS_Store
**/*.md
